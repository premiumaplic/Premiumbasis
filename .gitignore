# Секреты и данные — только на ПК владельца, никогда в GitHub
# «/» в начале — только папки в корне установки (D:\SchoolBot\app и т.д.),
# а не одноимённые папки внутри проекта (например docs/app — приложение учителя)
/config.ini
/data/
/python/
/app/
*.log
*.db
*.db-*
*.sqlite
*.zip

# Служебное
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
